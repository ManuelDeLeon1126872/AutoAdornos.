@using AutoAdornos.Web.UI.Helpers
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TurboPOS Web</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a href="@Url.Action("Index", "Store")" class="brand">
                <img src="@Url.Content("~/Content/Images/logo-turbopos.jpg")" alt="TurboPOS" class="brand-logo" />
            </a>
            <nav class="nav-links">
                @if (CartSessionManager.IsAuthenticated(Session))
                {
                    <a href="@Url.Action("Index", "Store")">Productos</a>
                    <a href="@Url.Action("Cart", "Store")">Carrito</a>
                    <a href="@Url.Action("Index", "Checkout")">Checkout</a>
                    <a href="@Url.Action("Logout", "Account")">Salir</a>
                }
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert error">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
</body>
</html>
