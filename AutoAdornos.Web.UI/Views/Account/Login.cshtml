@model AutoAdornos.Web.UI.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="card card-sm login-card">
    <div class="section-title">Acceso al canal web</div>
    <p class="muted">Este canal consume la capa de Integración del proyecto AutoAdornos.</p>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-row">
            @Html.LabelFor(m => m.Usuario)
            @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "Ingrese su usuario" })
            @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-row">
            @Html.LabelFor(m => m.Clave)
            @Html.PasswordFor(m => m.Clave, new { @class = "form-control", placeholder = "Ingrese su clave" })
            @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "field-validation-error" })
        </div>

        <button type="submit" class="btn btn-primary btn-block">Entrar</button>
    }
</section>
