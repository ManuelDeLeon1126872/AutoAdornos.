@model AutoAdornos.Web.UI.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="card card-sm login-card">
    <div class="section-title">¡Bienvenido a Auto Adornos!</div>
    <p class="muted">Inicia sesión en tu cuenta para comprar los mejores accesorios para tu vehículo.</p>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-row">
            @Html.LabelFor(m => m.Usuario, "Tu correo electrónico")
            @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "ejemplo@correo.com" })
            @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-row">
            @Html.LabelFor(m => m.Clave, "Tu contraseña")
            @Html.PasswordFor(m => m.Clave, new { @class = "form-control", placeholder = "********" })
            @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "field-validation-error" })
        </div>
        <div class="text-center mt-3">
            <p>¿No tienes cuenta? <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary btn-sm">Regístrate aquí</a></p>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Iniciar Sesión</button>
    }
</section>